# Copy this file to .env (which is gitignored) or export the variables in a
# systemd EnvironmentFile. Do not put passwords, tokens or a PIN in the repository.

# Mailbox used for logger alerts and (optionally) email commands.
# The Gmail app password belongs in ~/.msmtprc, not here.
ALERT_EMAIL=YOUR_EMAIL@example.com
MAIL_ADDRESS=YOUR_EMAIL@example.com
MAIL_DOMAIN=pi.example

# PIN for email commands: create a 6-digit file that is not in this repository
#   python3 -c "import secrets; print(f'{secrets.randbelow(10**6):06d}')" > ~/mail_control/pin
#   chmod 600 ~/mail_control/pin

# Published site location is Belfast, approximately 54.6 N, 5.9 W.
# Use your own coordinates if you reuse the weather logger.
SITE_LAT=54.6
SITE_LON=-5.9
SITE_NAME="Belfast, ~54.6N 5.9W"

# Local API host of a LEO satellite broadband dish, if you log dish statistics.
# Leave unset unless you have such a dish on the local network.
# DISH_GRPC_HOST=
# DISH_GRPC_PORT=9200

# Off-site backup remote. rclone credentials stay in rclone's own config, not here.
# RCLONE_REMOTE=gdrive:YOUR_BACKUP_FOLDER

# Optional paths for rerunning analysis scripts
# REPO_ROOT=/path/to/this/repository
# SPACE_WEATHER_DATA=/path/to/raw/data
# NAV_DIR=/path/to/broadcast/ephemeris
